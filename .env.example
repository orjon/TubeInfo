# Copy to .env and fill in. .env is gitignored; this file is committed.

# --- App identity (change here to rename the app everywhere) ---
# Used for the page title, PWA manifest name, install prompt and header.
# Read at build time, so rebuild after changing.
VITE_APP_NAME=SetOff
# Shown under the home-screen icon. Keep to 12 characters or fewer.
VITE_APP_SHORT_NAME=SetOff
VITE_APP_TAGLINE=London train times

# --- Server ---
# URL path the whole app (client and API) is served under.
BASE_PATH=/setoff
# TfL API key (api-portal.tfl.gov.uk). No app ID is needed any more.
# Use a different key (primary or secondary) for each deployed app, so one can
# be regenerated without breaking the other.
TFL_APP_KEY=
PORT=5005

# --- Client ---
VITE_MAPBOX_TOKEN=
