# Copy to .env and fill in. .env is gitignored; this file is committed.

# --- App identity (change here to rename the app everywhere) ---
# Used for the page title, PWA manifest name, install prompt and header.
# Read at build time, so rebuild after changing.
VITE_APP_NAME=Off You Pop
# Shown under the home-screen icon. Keep to 12 characters or fewer.
VITE_APP_SHORT_NAME=Off You Pop
VITE_APP_TAGLINE=London train times

# --- Server ---
# URL path the whole app (client and API) is served under.
BASE_PATH=/setoff
# TfL API key (api-portal.tfl.gov.uk). No app ID is needed any more.
# Use a different key (primary or secondary) for each deployed app, so one can
# be regenerated without breaking the other.
# NOTE: TfL allows about 500 requests per minute (as read on the TfL API portal;
# not checked in their docs). Arrivals are cached on the server for ARRIVALS_CACHE_SECONDS,
# so TfL is asked at most 60 / that many times a minute per station being watched (and
# once per stop for a merged station), however many people are watching it. At 15 seconds
# that is 4 a minute, which leaves room for about 125 stations at once. Statuses are
# cached 30 seconds. There is no rate limiter: if traffic ever grows, add a per-minute
# counter in tfl.js that waits before exceeding the limit.
TFL_APP_KEY=
# Seconds the server keeps a station's arrivals before asking TfL again (default 15)
ARRIVALS_CACHE_SECONDS=15
PORT=5005

# --- Client ---
VITE_MAPBOX_TOKEN=
