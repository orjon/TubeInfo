{
  "name": "tube-info-api",
  "version": "1.0.0",
  "description": "API for serving data Tube Info App. This API gets it's data from TfL Open Data",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "server": "nodemon server.js",
    "client": "pnpm --filter setoff-client dev",
    "dev": "concurrently \"pnpm server\" \"pnpm client\"",
    "build": "pnpm --filter setoff-client build",
    "test": "vitest run && pnpm --filter setoff-client test",
    "test:watch": "vitest"
  },
  "author": "orjon.com",
  "license": "MIT",
  "dependencies": {
    "config": "^3.3.1",
    "dotenv": "^8.2.0",
    "express": "^4.17.1",
    "express-validator": "^6.6.1",
    "moment": "^2.29.0"
  },
  "devDependencies": {
    "concurrently": "^5.3.0",
    "nodemon": "^2.0.4",
    "supertest": "^7.3.2",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@12.18.0"
}
